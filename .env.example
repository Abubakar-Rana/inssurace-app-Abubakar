# Copy to .env.local and fill in. NEVER commit .env.local.

# ---- Database ----
# Local Docker:  postgresql://certflow:certflow@localhost:5432/certflow
# Neon/Supabase: paste the pooled connection string (must include ?sslmode=require)
DATABASE_URL=postgresql://certflow:certflow@localhost:5432/certflow

# ---- L1: master Key Encryption Key ----
# 32 bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# This unwraps every tenant's data key. It is the ONE secret that must never
# touch the database, the repo, or a log line. Rotating it re-wraps all DEKs.
CERTFLOW_MASTER_KEK=

# ---- L3: sessions ----
# Signs the session cookie. >= 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating it signs everyone out, which is the emergency "revoke all sessions".
SESSION_SECRET=

# Public origin. Used for OIDC redirects and the cross-origin check on writes.
APP_URL=http://localhost:3000

# ---- L3: identity provider (OpenID Connect) ----
# CertFlow stores no passwords; the agency's IdP authenticates and enforces MFA.
# Google Workspace: OIDC_ISSUER=https://accounts.google.com
# Microsoft Entra:  OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# Register the app with redirect URI  <APP_URL>/api/auth/callback
# Scopes requested: openid + email only. `profile` is deliberately not asked
# for — users are pre-provisioned, so we never need the provider's copy of a
# display name.
# Until all four are set, sign-in falls back to a development-only path that is
# refused when NODE_ENV=production.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Which tenant the development sign-in uses.
DEV_TENANT_SLUG=whittington

# ---- L2: Gmail ----
# Phase 1 (dev only): a Google App Password on a dedicated mailbox.
# Production: OAuth 2.0 per tenant — App Passwords cannot be scoped or revoked
# per-integration, so they are unsuitable for customer mailboxes.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Who the app is allowed to email: comma-separated addresses, @domains, or "*".
# Unset, outside production, means ONLY GMAIL_USER — the safe default, because
# development runs against a real SMTP account and a database of test data.
# Set "*" to reply to whatever address a request actually came from; an agency
# taking real requests has to run this way, since the requester is not something
# we can enumerate in advance. Reserved domains (.example/.invalid/.test) are
# refused whatever this says, so seeded demo rows can never be emailed.
DELIVERY_ALLOWLIST=*

# How often the mailbox watcher re-checks its open connection, in seconds.
# This is the CEILING on how long a request can sit unseen; the server's own
# new-mail announcement is usually much faster. The check runs over a connection
# that is already open, so a low value costs almost nothing.
GMAIL_CHECK_SECONDS=2

# Set to 0 to stop a process watching the mailbox. Use it on the web server when
# running `npm run watch` as a separate worker, so only one process watches.
GMAIL_WATCH=

# Set to 1 to log every mailbox check. For diagnosing a watcher gone quiet.
GMAIL_WATCH_DEBUG=

# Set to 0 to stop the system emailing requesters to ask which company they
# meant. Those requests then go to a reviewer instead, as they did before.
# This is the only mail the system sends without a human pressing anything.
GMAIL_CLARIFY=

# Set to 1 to ingest EVERY message instead of only certificate requests.
# Debugging aid: use it when a real request did not appear on the dashboard, to
# see whether it reached the mailbox at all. Leave unset otherwise.
GMAIL_INGEST_ALL=

# ---- LLM (phase 5, not used yet) ----
ANTHROPIC_API_KEY=

# ---- SaaS: multi-agency ----
# Run every tenant transaction as the restricted `certflow_app` role, so the
# DATABASE enforces row-level security between agencies (not just our code).
# Strongly recommended. Requires `npm run db:migrate` (it grants the role).
DB_ENFORCE_RLS=1

# The one agency that may keep using GMAIL_USER / GMAIL_APP_PASSWORD above
# until it connects its own mailbox in Settings → Email. Every other agency
# must connect its own. Defaults to DEV_TENANT_SLUG, then "whittington".
MAIL_ENV_TENANT_SLUG=

# How often the worker re-reads which agency mailboxes to watch and runs any
# NowCerts syncs that are due, in seconds.
GMAIL_SUPERVISE_SECONDS=30

# ---- Connect your inbox (OAuth) ----
# Agencies connect Gmail or Outlook from Settings -> Email with a consent
# pop-up, so nobody types an app password. Register CertFlow once with each
# provider and put the credentials here; the buttons stay disabled until you do.
#
# GOOGLE: Google Cloud console -> APIs & Services. Enable the Gmail API, create
# an OAuth client (Web application) with redirect URI
#   <APP_URL>/api/mail/oauth/google/callback
# Scopes requested: gmail.readonly + gmail.send (read and send; never delete).
# These are RESTRICTED scopes: before customers outside your own Workspace can
# connect, the app needs Google verification AND an annual CASA security
# assessment. Until then it runs in Testing mode (max 100 named test users,
# and each connection expires after 7 days).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# MICROSOFT: Entra ID (Azure) -> App registrations. Accounts in any
# organizational directory and personal Microsoft accounts. Redirect URI (Web)
#   <APP_URL>/api/mail/oauth/microsoft/callback
# Delegated permissions: Mail.Read, Mail.Send, offline_access, openid, email.
# Some customers' IT will need to approve it for their organisation.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# How often an OAuth-connected inbox is checked for new mail, in seconds.
# (App-password inboxes use IMAP IDLE and are pushed, not polled.)
MAIL_API_POLL_SECONDS=10

# ---- LLM reading (lib/llm) ----
# Which judgements a language model may make. Each reader is separately
# switchable because each has its own guards and its own test suite:
#   LLM_READING=extract          who the certificate is FOR (wired)
#   LLM_READING=extract,classify several
#   LLM_READING=all              every reader
# Unset means the pattern readers alone - which is what every test suite runs.
# A missing ANTHROPIC_API_KEY turns it off whatever this says.
LLM_READING=
ANTHROPIC_API_KEY=

# Call the model, log how its answer compares with the pattern reader, then act
# on the PATTERN anyway. The safe first week of any rollout.
LLM_SHADOW=

# Default claude-haiku-4-5 (fast and cheap for one short email).
LLM_MODEL=
LLM_TIMEOUT_MS=15000
